{
  "expo": {
    "name": "Önvizit",
    "slug": "intake-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": ["onvizit", "intake"],
    "userInterfaceStyle": "automatic",
    "locales": {
      "tr": "./src/locales/app-tr.json",
      "en": "./src/locales/app-en.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ariomoniri.intakemobile",
      "associatedDomains": ["webcredentials:3-211-2-143.sslip.io"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ariomoniri.intakemobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Önvizit; adım, nabız ve uyku verilerinizi yalnızca bu cihazda görüntülemek ve ancak sizin onayınızla vizit notunuza eklemek için okur.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "./plugins/withVoiceAudio",
      "./plugins/withCertificatePinning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "asrHosts": ["127.0.0.1", "172.20.10.3"],
      "ttsLanes": [
        { "id": "voxcpm2", "port": 8805 },
        { "id": "freya", "port": 8803 }
      ],
      "certificatePins": [],
      "glitchtipDsn": "",
      "eas": {
        "projectId": "307d4cf2-c447-4855-8110-da59fb5ed170"
      }
    }
  }
}
