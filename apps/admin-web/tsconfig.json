{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "e2e", "app", "proxy.ts", "next.config.ts"],
  "exclude": ["node_modules", ".next"]
}
