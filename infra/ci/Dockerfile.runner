# INT-426 — the aws-ci gate runner image (docs/ci/aws-ci.md).
#
# One image holds every tool the gate set calls, at the version GitHub Actions
# runs, so a verdict here is the verdict CI would give:
#   uv 0.12.19, node 22.23.2 and pnpm 9.15.9 are what ci.yml's setup actions
#   installed on 27 Sep 2026; trivy 0.70.0, gitleaks 8.24.3, osv-scanner 2.5.1
#   and syft 1.51.1 are what security.yml's pinned actions run. semgrep, bandit
#   and checkov are not baked in: `make security` runs them through uvx at the
#   Makefile's own pins.
#
# Every download is checked against the sha256 its vendor publishes, before it
# is unpacked; every base image is pinned by digest. The docker CLI and the
# compose plugin come from the official image, pinned by digest, because the
# static tarballs have no published checksum.
#
# The runner never talks to the host's docker: check-integration's containers
# run inside the dind sidecar (infra/ci/compose.yaml), reached on loopback.
FROM docker:28.5.2-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS dockercli

FROM ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60

ARG UV_VERSION=0.12.19
ARG UV_SHA256=23bf5552d220e0842b65c862097b2ebaeba0064b74eda5e565e77fd25969d8c8
ARG NODE_VERSION=22.23.2
ARG NODE_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
ARG PNPM_VERSION=9.15.9
ARG TRIVY_VERSION=0.70.0
ARG TRIVY_SHA256=8b4376d5d6befe5c24d503f10ff136d9e0c49f9127a4279fd110b727929a5aa9
ARG GITLEAKS_VERSION=8.24.3
ARG GITLEAKS_SHA256=9991e0b2903da4c8f6122b5c3186448b927a5da4deef1fe45271c3793f4ee29c
ARG OSV_SCANNER_VERSION=2.5.1
ARG OSV_SCANNER_SHA256=f9f25499a2c8cc367b3af45df2ea7eeca7fbccceab9c35079968f4b3652194be
ARG SYFT_VERSION=1.51.1
ARG SYFT_SHA256=8fcb33017a0dc1058298c923c436d19dfa68ae93968e0b423248542e3afb9fc3

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git make build-essential pkg-config \
      python3 python3-dev xz-utils unzip jq procps \
 && apt-get clean

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

WORKDIR /tmp/tools

RUN curl --proto '=https' -fsSLo uv.tgz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
 && echo "${UV_SHA256}  uv.tgz" | sha256sum -c - \
 && tar -xzf uv.tgz --strip-components=1 -C /usr/local/bin uv-x86_64-unknown-linux-gnu/uv uv-x86_64-unknown-linux-gnu/uvx \
 && curl --proto '=https' -fsSLo node.txz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && echo "${NODE_SHA256}  node.txz" | sha256sum -c - \
 && tar -xJf node.txz --strip-components=1 -C /usr/local \
 && curl --proto '=https' -fsSLo trivy.tgz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
 && echo "${TRIVY_SHA256}  trivy.tgz" | sha256sum -c - \
 && tar -xzf trivy.tgz -C /usr/local/bin trivy \
 && curl --proto '=https' -fsSLo gitleaks.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  gitleaks.tgz" | sha256sum -c - \
 && tar -xzf gitleaks.tgz -C /usr/local/bin gitleaks \
 && curl --proto '=https' -fsSLo /usr/local/bin/osv-scanner "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
 && echo "${OSV_SCANNER_SHA256}  /usr/local/bin/osv-scanner" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/osv-scanner \
 && curl --proto '=https' -fsSLo syft.tgz "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" \
 && echo "${SYFT_SHA256}  syft.tgz" | sha256sum -c - \
 && tar -xzf syft.tgz -C /usr/local/bin syft \
 && rm -f uv.tgz node.txz trivy.tgz gitleaks.tgz syft.tgz \
 && corepack enable pnpm \
 && groupadd --gid 10001 ci \
 && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/ci --shell /bin/bash ci \
 && install -d -o 10001 -g 10001 /work /out /caches

USER 10001:10001
WORKDIR /work

ENV HOME=/home/ci \
    CI=true \
    COREPACK_HOME=/home/ci/.corepack \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    DOCKER_HOST=tcp://127.0.0.1:2375 \
    UV_CACHE_DIR=/caches/uv \
    UV_LINK_MODE=copy \
    npm_config_store_dir=/caches/pnpm \
    TRIVY_CACHE_DIR=/caches/trivy \
    XDG_CACHE_HOME=/caches/xdg

# corepack fetches pnpm once, at build, into the ci user's home
RUN corepack prepare "pnpm@${PNPM_VERSION}" --activate && pnpm --version

HEALTHCHECK NONE

CMD ["bash"]
