# INT-463 — the supervisor of the intake-aws-ci GitHub Actions runner. It runs
# as root, unsandboxed, because the guards must see the real file system: the
# staging paths they deny, the NVMe mount, the root disk and the firewall.
# cycle.sh loops: guards and an ephemeral registration, one job in the
# sandboxed intake-aws-ci-job.service, then the workspace and container wipe.
# No job code ever runs in this unit.
[Unit]
Description=Supervisor of the ephemeral intake-aws-ci Actions runner (INT-463)
After=network-online.target dlami-nvme.service docker.service
Wants=network-online.target
RequiresMountsFor=/opt/dlami/nvme
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/lib/intake-aws-ci-runner/bin/cycle.sh
Restart=always
RestartSec=30
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
