{
  "__comment": "infra/observability/grafana/api-slo-dashboard.json — dashboard as code for the api SLOs (INT-021; files/10 §6 golden signals). Panels reference only series from observability/metrics_catalog.yaml or slo: recording rules from infra/observability/prometheus-rules.yaml; tests/observability/test_slo_generator.py enforces both. Provisioned into Grafana by the observability deploy (INT-023).",
  "uid": "intake-api-slo",
  "title": "api — SLOs, burn rate and golden signals",
  "tags": ["slo", "api", "intake"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability burn rate (1h, multiples of budget)",
      "description": "slo:api_availability error ratio over 1h divided by the 99.9 % budget (0.001). Pages at 14.4, tickets at 1 — see docs/runbooks/slo-burn.md.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:api_availability:error_ratio_rate1h / 0.001"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latency burn rate (1h, multiples of budget)",
      "description": "slo:api_latency error ratio over 1h divided by the 99 % budget (0.01).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:api_latency:error_ratio_rate1h / 0.01"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Availability — error ratio by burn window",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "slo:api_availability:error_ratio_rate5m" },
        { "refId": "B", "expr": "slo:api_availability:error_ratio_rate1h" },
        { "refId": "C", "expr": "slo:api_availability:error_ratio_rate6h" },
        { "refId": "D", "expr": "slo:api_availability:error_ratio_rate3d" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency — share of requests slower than 500 ms",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "slo:api_latency:error_ratio_rate5m" },
        { "refId": "B", "expr": "slo:api_latency:error_ratio_rate1h" },
        { "refId": "C", "expr": "slo:api_latency:error_ratio_rate6h" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency — p50 / p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])))"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Traffic — requests per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"api\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors — 5xx per second by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{service=\"api\",status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Saturation — CPU, memory, file descriptors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"api\"}[5m])"
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes{job=\"api\"}"
        },
        {
          "refId": "C",
          "expr": "process_open_fds{job=\"api\"} / process_max_fds{job=\"api\"}"
        }
      ]
    }
  ]
}
