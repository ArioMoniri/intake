{
  "__comment": "infra/observability/grafana/ops-dashboards/staging-overview.json — GENERATED by intake_platform.ops_dashboards (INT-481). Do not edit: change the module and re-emit with scripts/observability/ops_dashboards.py --emit; tests/observability/test_ops_dashboards.py fails on drift.",
  "uid": "intake-ops-staging-overview",
  "title": "Staging — alerts, probes, host and deploys",
  "description": "The synthetic staging host at a glance. Deploy markers come from deploy.sh.",
  "tags": [
    "ops",
    "intake",
    "staging"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deploy started",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "(time() - deploy_event_timestamp_seconds{stage=\"started\"}) < 90",
        "step": "30s",
        "titleFormat": "deploy started",
        "textFormat": "{{head_sha}}"
      },
      {
        "name": "Deploy completed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "green",
        "expr": "(time() - deploy_event_timestamp_seconds{stage=\"completed\"}) < 90",
        "step": "30s",
        "titleFormat": "deploy completed",
        "textFormat": "{{head_sha}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing alerts by severity",
      "description": "Alerts Prometheus is firing now, counted by severity. The admin console's Alerts page shows the same alerts from Alertmanager, ids only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Firing alerts",
      "description": "One row per firing alert with its id labels. Annotations are never shown here; the runbook is named by the alert (docs/runbooks/).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (alertname, severity, component, service, slo, budget_id) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Synthetic probes (1 up, 0 down)",
      "description": "Every staging service's own health endpoint, probed inside the host by the blackbox exporter every 30 s (infra/staging/observability/prometheus.yml).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (component) (probe_success)",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probe duration",
      "description": "How long each synthetic probe took, end to end, inside the host.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (component) (probe_duration_seconds)",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU busy and memory used",
      "description": "The whole host: staging, this telemetry tier and the CI runner slots share it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu busy"
        },
        {
          "refId": "B",
          "expr": "1 - node_memory_memavailable_bytes / node_memory_memtotal_bytes",
          "legendFormat": "memory used"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Root disk free",
      "description": "Free bytes on the host's root disk. The line is the CI runner's own start guard (25 GB, docs/ci/aws-ci.md): below it every CI job is refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 25000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes",
          "legendFormat": "free"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Load average",
      "description": "Run-queue length; the host has 8 vCPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1",
          "legendFormat": "1 min"
        },
        {
          "refId": "B",
          "expr": "node_load15",
          "legendFormat": "15 min"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prometheus storage against its cap",
      "description": "Prometheus keeps 30 days or 4 GB, whichever comes first (infra/staging/compose.obs.yaml).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_storage_blocks_bytes",
          "legendFormat": "stored"
        },
        {
          "refId": "B",
          "expr": "prometheus_tsdb_retention_limit_bytes",
          "legendFormat": "cap"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Series in memory",
      "description": "Active series. A jump here is a cardinality change worth reading.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "series"
        }
      ]
    }
  ]
}
