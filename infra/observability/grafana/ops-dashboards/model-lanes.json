    {
      "id": 5,
      "type": "timeseries",
      "title": "Adapter failures and fallbacks (24 h)",
      "description": "Model-gateway adapter failures and the fallbacks they triggered (INT-024).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
