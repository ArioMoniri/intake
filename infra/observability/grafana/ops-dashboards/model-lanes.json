    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TTS characters by vendor (24 h)",
      "description": "Characters sent for dynamic synthesis, the quantity the cost module prices. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
