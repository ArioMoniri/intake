        {
          "refId": "A",
          "expr": "max by (alertname, budget_id, scope, period) (ALERTS{alertname=~\"CostBudget.*\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ]
