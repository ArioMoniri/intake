        "step": "30s",
        "titleFormat": "deploy completed",
        "textFormat": "{{head_sha}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Backend Work requests by type (per minute)",
      "description": "Model-lane usage: every Backend Work job the clinical agent runs (extraction and the rest), by type. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(work_latency_ms_count[5m])) * 60",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Backend Work p95 latency by type",
      "description": "metrics_catalog target: extract_slots p50 below 3 s. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(work_latency_ms_bucket[5m])))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backend Work failures by type (24 h)",
      "description": "Failed jobs, receipts rather than crashes (INT-092). Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(work_failed_total[24h]))",
          "legendFormat": "{{type}}"
        }
