{
  "__comment": "infra/observability/grafana/ops-dashboards/ci-runner.json — GENERATED by intake_platform.ops_dashboards (INT-481). Do not edit: change the module and re-emit with scripts/observability/ops_dashboards.py --emit; tests/observability/test_ops_dashboards.py fails on drift.",
  "uid": "intake-ops-ci-runner",
  "title": "CI runner — queue, durations and gates",
  "description": "The self-hosted CI runner on the staging host and the gates it reports.",
  "tags": [
    "ops",
    "intake",
    "staging"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deploy started",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "(time() - deploy_event_timestamp_seconds{stage=\"started\"}) < 90",
        "step": "30s",
        "titleFormat": "deploy started",
        "textFormat": "{{head_sha}}"
      },
      {
        "name": "Deploy completed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "green",
        "expr": "(time() - deploy_event_timestamp_seconds{stage=\"completed\"}) < 90",
        "step": "30s",
        "titleFormat": "deploy completed",
        "textFormat": "{{head_sha}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CI runs queued and running",
      "description": "The newest runs of every workflow on main, by GitHub's status: queued is the queue. Read by the probes service's ops collector with a read-only token (INT-187). Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (status) (ops_cicd_run{status=~\"queued|waiting|requested|pending|in_progress\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CI run duration by workflow",
      "description": "Seconds from a completed run's start to its end; a running run has none. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (workflow) (ops_cicd_run_duration_seconds)",
          "legendFormat": "{{workflow}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Required gates on main's head",
      "description": "Each required gate on the watched branch's head commit and its conclusion. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (workflow, gate, conclusion) (ops_cicd_branch_gate)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ops collector sources (1 up, 0 failing)",
      "description": "Whether the collector's last read of each source worked: failing is not the same as not configured. Nothing on the staging host emits this series yet, so there the panel reads 'No data' rather than a figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (source) (ops_collector_source_up)",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Host CPU busy while CI runs",
      "description": "The CI runner slots share this host with staging (docs/ci/aws-ci.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu busy"
        }
      ]
    }
  ]
}
