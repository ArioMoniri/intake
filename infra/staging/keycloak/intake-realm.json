{
  "realm": "intake",
  "displayName": "Önvizit staff (staging host, synthetic patients only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "rememberMe": false,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 28800,
  "eventsEnabled": true,
  "eventsExpiration": 5184000,
  "enabledEventTypes": [
    "LOGIN"
  ],
  "adminEventsEnabled": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyRpEntityName": "intake",
  "webAuthnPolicySignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyRpId": "",
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "required",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyAcceptableAaguids": [],
  "webAuthnPolicyExtraOrigins": [],
  "browserFlow": "staff browser",
  "authenticatorConfig": [
    {
      "alias": "amr pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "28800"
      }
    },
    {
      "alias": "amr otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "28800"
      }
    },
    {
      "alias": "amr hwk",
      "config": {
        "default.reference.value": "hwk",
        "default.reference.maxAge": "28800"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "staff browser",
      "description": "files/08 §2.3 (INT-365): resume an SSO session, or a password and a second factor, each execution tagged with its RFC 8176 amr value. The api refuses a token without pwd plus otp or hwk, or without hwk for a role that reaches patient content.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "staff browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "staff browser forms",
      "description": "Password (amr pwd), then the second factor. Both are REQUIRED and nothing sits beside them.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr pwd",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "staff second factor",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "staff second factor",
      "description": "WebAuthn (amr hwk, UV required) is REQUIRED: a user with no passkey enrols one via webauthn-register after the password (INT-550). TOTP (amr otp) is DISABLED until INT-389. intake-webauthn-session-notes writes the aaguid/credential_id notes (INT-378).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "intake-webauthn-session-notes",
          "authenticatorConfig": "amr hwk",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr otp",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "platform_owner",
        "description": "Everything, all tenants; patient content only via break-glass. Named on every separation-of-duties list (files/08 §2.1)"
      },
      {
        "name": "platform_admin",
        "description": "Infrastructure only, no clinical surfaces; no pack promotion, device flag, study assertion, connector endpoints or audit configuration (files/08 §2.1)"
      },
      {
        "name": "tenant_admin",
        "description": "One tenant: branding, contacts, technical onboarding. No connector endpoints, pack enablement, key rotation or clinician provisioning (files/08 §2.1)"
      },
      {
        "name": "tenant_clinical_responsible",
        "description": "One tenant, clinical governance: approves clinician accounts and acknowledges REDs (files/08 §2.1)"
      },
      {
        "name": "clinical_lead",
        "description": "Protocol review, safety queues, quarantine; tier-3 approver; patient content only via break-glass (files/08 §2.1)"
      },
      {
        "name": "qms_owner",
        "description": "ISO 13485 / IEC 62304 change control; second signature on device_functions, the study assertion and all-tenant promotion (files/08 §2.1)"
      },
      {
        "name": "investigator",
        "description": "The sealed research store, one study_id; never production clinical data (files/08 §2.1)"
      },
      {
        "name": "auditor",
        "description": "Read-only evidence export for an inspector, notified body or counsel; writes nothing, every read audited (files/08 §2.1)"
      },
      {
        "name": "sre_oncall",
        "description": "Operations and tier-1 safe-direction actions; no patient content (files/08 §2.1)"
      },
      {
        "name": "compliance_officer",
        "description": "Consent, DSAR, transfer register, break-glass approval; patient content only via break-glass (files/08 §2.1)"
      },
      {
        "name": "researcher",
        "description": "De-identified aggregates at k >= 10; no patient content (files/08 §2.1)"
      },
      {
        "name": "support",
        "description": "One patient, one patient-granted expiring grant on the Doctor Link model (files/08 §2.1)"
      },
      {
        "name": "admin",
        "description": "Platform administration (console; tiered actions per files/08 §2)"
      },
      {
        "name": "clinician",
        "description": "Clinician console access (notes, review queues)"
      },
      {
        "name": "ops",
        "description": "Operations: dashboards, probes, SLO review — no clinical reads"
      }
    ]
  },
  "clients": [
    {
      "clientId": "api",
      "name": "INTAKE api (bearer-only resource server)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "admin-web",
      "name": "Önvizit admin console (behind oauth2-proxy, confidential)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://admin.${STAGING_HOSTNAME}/oauth2/callback"
      ],
      "webOrigins": [
        "https://admin.${STAGING_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://admin.${STAGING_HOSTNAME}/"
      },
      "protocolMappers": [
        {
          "name": "audience api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org",
            "claim.name": "org",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aaguid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "intake.webauthn.aaguid",
            "claim.name": "aaguid",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "credential_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "intake.webauthn.credential_id",
            "claim.name": "credential_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "clientAuthenticatorType": "client-secret",
      "secret": "${INTAKE_ADMIN_WEB_CLIENT_SECRET}"
    },
    {
      "clientId": "admin-web-stepup",
      "name": "Önvizit admin console step-up (public, PKCE, re-authentication only)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://admin.${STAGING_HOSTNAME}/step-up/callback"
      ],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic"
      ],
      "authenticationFlowBindingOverrides": {},
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aaguid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "intake.webauthn.aaguid",
            "claim.name": "aaguid",
            "jsonType.label": "String",
            "access.token.claim": "false",
            "introspection.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "credential_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "intake.webauthn.credential_id",
            "claim.name": "credential_id",
            "jsonType.label": "String",
            "access.token.claim": "false",
            "introspection.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}}},{\"name\":\"email\",\"displayName\":\"${email}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"org\",\"displayName\":\"Organisation id (admin console actor block)\",\"multivalued\":false,\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$\"}}},{\"name\":\"tenant\",\"displayName\":\"Tenant id (admin console scope)\",\"multivalued\":false,\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$\"}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
