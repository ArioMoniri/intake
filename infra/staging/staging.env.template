# INT-345 staging environment. This file lists KEYS ONLY; nothing secret is
# committed.
#
# init.sh builds the real file from this list on the host, at
# /etc/intake-staging/.env: owner root, mode 0600, in a 0700 directory.
#   STAGING_HOSTNAME  from the owner at init time: <EIP-dashed>.sslip.io
#   *_PASSWORD        256-bit random hex generated on the host, once
#   MINIO_ROOT_USER   the object store's root access key, generated the same
#                     way. The minio service and the API share the pair, and
#                     the API refuses a non-dev boot without it (INT-325)
#   OPENBAO_TOKEN     the API's periodic token, minted by init.sh under the
#                     intake-api policy. It is never the root token.
#   INTAKE_TOKENIZATION_KEY
#                     INT-352: the OTP tier's phone-tokenization (HMAC) key,
#                     generated the same way, once. A re-run never rotates
#                     it, since a new key would fork every phone pseudonym.
#   KEYCLOAK_DB_PASSWORD, KEYCLOAK_ADMIN_PASSWORD
#                     INT-421: Keycloak's own database role, and the master
#                     realm's bootstrap admin (intake-bootstrap). Both are
#                     generated the same way, once.
#   INTAKE_ADMIN_WEB_CLIENT_SECRET
#                     INT-421: the admin-web client's secret, which Keycloak
#                     (through the realm import) and oauth2-proxy share
#   OAUTH2_PROXY_COOKIE_SECRET
#                     INT-421: oauth2-proxy's session-cookie key, 32 random
#                     bytes as base64url, the form oauth2-proxy accepts
#                     (gen_cookie_secret)
# The OpenBao unseal key shares and root token go to a separate root-only
# file, /etc/intake-staging/openbao-init.json. They never enter this file or
# any container environment.
#
# INT-352: the operator sets the keys below by hand in the host's env file.
# init.sh generates none of them and writes each one empty. Each may stay
# empty, and the API reads empty as unset and fails closed:
#   INTAKE_APP_ATTEST_TEAM_ID      Apple App ID prefix (INT-344, HB-A3). With
#                                  none, every iOS attestation is refused
#   INTAKE_APP_ATTEST_BUNDLE_ID    empty = the app's committed bundle id
#   INTAKE_APP_ATTEST_ENVIRONMENT  empty = production
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
#                                  the SMS vendor. deploy.sh refuses a team
#                                  id without all three (require_sms_with_app_attest)
#   INTAKE_ADMIN_IP_ALLOWLIST      INT-421: the admin console's source ranges
#                                  (HB-A16, the owner's). Empty admits nobody
STAGING_HOSTNAME=
POSTGRES_PASSWORD=
PG_APP_RW_PASSWORD=
PG_CLINICIAN_RO_PASSWORD=
PG_AUDIT_WRITER_PASSWORD=
PG_LEARNING_READER_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
OPENBAO_TOKEN=
INTAKE_TOKENIZATION_KEY=
INTAKE_APP_ATTEST_TEAM_ID=
INTAKE_APP_ATTEST_BUNDLE_ID=
INTAKE_APP_ATTEST_ENVIRONMENT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
INTAKE_ADMIN_WEB_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
INTAKE_ADMIN_IP_ALLOWLIST=
