# INT-345 staging edge. This is the only published service: 80 for the ACME
# HTTP-01 challenge and the HTTPS redirect, 443 for the API.
#
# The certificate is automatic (Let's Encrypt) for STAGING_HOSTNAME, which is
# <EIP-dashed>.sslip.io on the AWS host. No ACME account mailbox is set:
# naming one is HB-I14, a human fact, and Let's Encrypt issues without it.
# No access log is configured, so URLs (Doctor Link paths included) are never
# written to disk (invariant 6).
{
	admin off
	servers {
		# HTTP/3 would need 443/udp, which is not published
		protocols h1 h2
	}
}

{$STAGING_HOSTNAME} {
	header {
		# Every response states what this host may hold (HB-I5, HB-L11)
		X-Intake-Environment "staging-synthetic-only"
		-Server
	}
	reverse_proxy api:8000
}

# INT-421: the admin console. Every request goes through oauth2-proxy, which
# admits a signed-in Keycloak session only. The one exception is the
# console's /healthz.
admin.{$STAGING_HOSTNAME} {
	header {
		X-Intake-Environment "staging-synthetic-only"
		-Server
	}
	reverse_proxy oauth2-proxy:4180
}

# INT-421: Keycloak, for the staff realm's login pages and OIDC endpoints only.
# Its admin console and the master realm are not routed: the operator works
# with kcadm.sh inside the container, over SSM. The management port (9000:
# health, metrics) is never routed.
auth.{$STAGING_HOSTNAME} {
	header {
		X-Intake-Environment "staging-synthetic-only"
		-Server
	}
	@not_public path /admin /admin/* /realms/master /realms/master/* /metrics /health /health/*
	respond @not_public 404
	reverse_proxy keycloak:8080
}
