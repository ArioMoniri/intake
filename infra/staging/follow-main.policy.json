{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ShipTheReleaseArchiveUnderOnePrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::onvizit-deploy-artefacts-235229001983/staging-follow/*"
    },
    {
      "Sid": "RunOneDocumentOnTheSyntheticHostOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:235229001983:instance/i-0e489e48739f5de98",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadTheCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
