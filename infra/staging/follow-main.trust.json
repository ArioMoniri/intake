{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheSyntheticStagingEnvironmentOfThisRepository",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::235229001983:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:ArioMoniri/intake:environment:synthetic-staging"
        }
      }
    }
  ]
}
