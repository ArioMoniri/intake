# INT-515: the staging voice-runtime image. Multi-stage, non-root, every base
# pinned by digest — the same bases, lock and server pin as Dockerfile.api
# (INT-345), so the two images cannot drift apart on a toolchain. The build
# context is the repository root; Dockerfile.voice-runtime.dockerignore decides
# what is sent.
#
# /version is stamped from the GIT_SHA and BUILT_AT build args, refused when
# absent or "dev". The third stamp, sbom_digest, describes this image, so the
# image cannot carry it: deploy.sh passes INTAKE_VOICE_RUNTIME_SBOM_DIGEST to
# the container at start (lib.sh stamp_voice_runtime_sbom).
#
# The process is `intake_voice_runtime.serve:app_from_env`, which hardens
# itself before it binds anything (core dumps off, not dumpable, memory
# locked: invariant 3). It writes nothing: the container's root is read-only
# and its one tmpfs is noexec (compose.yaml).
#
# Digests as in Dockerfile.api, resolved from the registries' v2 APIs on
# 26 Sep 2026:
#   ghcr.io/astral-sh/uv:0.12.19       (MIT OR Apache-2.0)
#   python:3.12.14-slim-trixie          (PSF-2.0)

FROM ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424 AS uv

FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
COPY . /app
# The runtime and its workspace dependencies, installed exactly as locked, as
# editable installs, so the repo-relative files it reads (the model registry)
# resolve under /app. The ASGI server is not in the lock and is added
# hash-pinned, from the same file the api image uses.
RUN uv sync --frozen --no-dev --package intake-voice-runtime \
 && uv pip install --python /app/.venv/bin/python --require-hashes --no-deps \
      -r infra/staging/requirements-server.txt

FROM python:3.12.14-slim-trixie@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS runtime
ARG GIT_SHA
ARG BUILT_AT
RUN if [ -z "$GIT_SHA" ] || [ "$GIT_SHA" = "dev" ] || [ -z "$BUILT_AT" ] || [ "$BUILT_AT" = "dev" ]; then \
      echo "refusing to build: GIT_SHA and BUILT_AT must be real stamps (deploy.sh sets them)" >&2; \
      exit 1; \
    fi \
 && groupadd --system --gid 10001 intake \
 && useradd --system --uid 10001 --gid 10001 --no-create-home \
      --home-dir /nonexistent --shell /usr/sbin/nologin intake
# root-owned and therefore read-only to the service user
COPY --from=builder /app /app
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INTAKE_GIT_SHA=${GIT_SHA} \
    INTAKE_BUILT_AT=${BUILT_AT}
LABEL org.opencontainers.image.title="intake-voice-runtime staging (synthetic patients only)" \
      org.opencontainers.image.revision=${GIT_SHA} \
      org.opencontainers.image.created=${BUILT_AT}
WORKDIR /app
USER 10001:10001
EXPOSE 8100
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=6 \
  CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/healthz', timeout=2).status == 200 else 1)"]
# No proxy sits in front of this process: no edge routes to it, and its only
# callers are on the deployment's internal networks.
CMD ["uvicorn", "intake_voice_runtime.serve:app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8100", "--no-server-header"]
